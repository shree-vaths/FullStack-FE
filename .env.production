# Used by `npm run build` only (Vite loads .env.production in production mode).
# Not a secret: it is inlined into the public JS bundle. Committed on purpose so
# the build works on Render without dashboard settings; a variable of the same
# name set on the host overrides it.
#
# The API must allow this site's origin via CORS (server env CORS_ORIGINS).
VITE_API_BASE_URL=https://fullstack-be-ewy9.onrender.com
